#!/bin/sh
set -e
capture_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
capture_python="${CODEX_MONITOR_PYTHON:-$(command -v python3.12 || true)}"
if [ -z "$capture_python" ] && [ -x "$HOME/.local/bin/python3.12" ]; then
  capture_python="$HOME/.local/bin/python3.12"
fi
if [ -z "$capture_python" ]; then
  capture_python="$(command -v python3.11 || true)"
fi
if [ -z "$capture_python" ] && python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
  capture_python="$(command -v python3)"
fi
if [ -z "$capture_python" ]; then
  echo "Python 3.11 이상이 필요합니다." >&2
  exit 1
fi
exec "$capture_python" -B "$capture_dir/capture.py" "$@"
